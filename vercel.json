{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "40mb",
        
        "includeFiles": ["dist/**", "node_modules/**"] 
      }
    }
  
  ],
  "routes": [
    {
      "src": "/",
      "dest": "src/main.ts"
    },
    {
      "src": "/hoardings/(.*)",
      "dest": "src/main.ts"
    },
    {
      "src": "/mail/(.*)",
      "dest": "src/main.ts"
    },

    {
      "src": "/api/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "npm run build" 
}